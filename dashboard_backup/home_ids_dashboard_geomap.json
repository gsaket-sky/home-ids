    {
      "type": "text",
      "title": "\ud83d\udcd6 Novice Analyst Guide: ASN Risk Ledger & Geo-Traffic Dynamics",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "transparent": true,
      "options": {
        "mode": "markdown",
        "content": "### \ud83c\udfe2 Autonomous System (ASN) Risk & Geographic Entropy\n* **ASN Risk Ledger:** Lists active destination networks and ISPs. High ASN scores indicate hosts residing in bulletproof hosting ASNs.\n* **Geographic Entropy & Query Volume:** Measures domain entropy and query rate per geographic location to detect covert C2 tunnels."
      }
    },
    {
      "type": "table",
      "title": "\ud83c\udfe2 ASN Risk Ledger & Beaconing Locations",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "datasource": {
        "type": "prometheus",
        "uid": "dfm29b4en3im8e"
      },
      "targets": [
        {
          "expr": "home_ids_asn_risk_score",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "sum by (asn) (increase(home_ids_geo_beaconing_total[1h]))",
          "format": "table",
          "instant": true,
          "refId": "B"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "asn",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "__name__": true
            },
            "renameByName": {
              "asn": "ASN",
              "org": "Organization / ISP",
              "Value #A": "Risk Score",
              "Value #B": "Beaconing Hits"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": [
              {
                "desc": true,
                "displayName": "Risk Score"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "center"
          },
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 4
              },
              {
                "color": "red",
                "value": 6
              }
            ]
          }
        },
        "overrides": [
