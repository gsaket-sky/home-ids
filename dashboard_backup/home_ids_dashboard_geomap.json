    {
      "type": "timeseries",
      "title": "Geographic Traffic Metrics (Query Rate / Unique Domains / Entropy)",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "datasource": {
        "type": "prometheus",
        "uid": "dfm29b4en3im8e"
      },
      "targets": [
        {
          "expr": "sum by (country) (home_ids_geo_queries_per_minute)",
