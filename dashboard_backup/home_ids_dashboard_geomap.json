          "format": "table",
          "instant": true,
          "refId": "B"
        }
      ],
      "options": {
        "view": {
          "id": "zero",
          "lat": 20,
          "lon": 0,
          "zoom": 2
        },
        "style": {
          "size": {
            "fixed": 8
          },
          "color": {
            "field": "Value #A"
          }
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 4
              },
              {
                "color": "orange",
                "value": 6
