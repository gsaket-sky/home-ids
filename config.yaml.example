# =============================================================================
# Home-IDS configuration — config.yaml
# =============================================================================
# Every setting below is grouped by what it actually controls, not by whether it
# needs a restart. Restart-vs-live behavior is called out on each key instead:
#
#   [LIVE]    — edit this file and save; scripts/scheduler.py's watcher (or the
#               app's own file-mtime check) picks it up within a few seconds,
#               no restart needed.
#   [RESTART] — the app reads this once at boot. Editing it here is saved and
#               will NOT be silently overwritten, but it has no effect on the
#               running process until you restart the service. This is a
#               deliberate safety rail (config.py's _STATIC_KEYS protection) for
#               settings where changing them underneath a running process would
#               corrupt state — e.g. swapping the model file path mid-run.
#
# Secrets are NOT in this file at all — see the "secrets" note near the bottom.
# They live in .env (path set by env_file below) and are pulled in as
# environment variables at every reload.
#
# This file replaces config.json. See CONFIG_AUDIT_REPORT.md for the full
# audit history of every key: what reads it, what was dead and removed, what
# was silently defaulting and is now explicit.
# =============================================================================


# -----------------------------------------------------------------------------
# service_ports — network ports this process listens on
# -----------------------------------------------------------------------------
service_ports:
  # Prometheus /metrics scrape port (Grafana dashboards read from here).
  # [RESTART]
  metrics_port: 9105

  # Local-only IPC/webhook port: receives Telegram bot webhooks and serves the
  # Fritz!Box isolate/hosts endpoints used by mitigation/ips.py. Not meant to
  # be internet-exposed. [RESTART]
  fastapi_port: 8010


# -----------------------------------------------------------------------------
# paths — every file/directory this process reads from or writes to.
# All relative paths resolve against the directory you LAUNCH the process
# from (your repo root — the same directory this config.yaml lives in), NOT
# against src/. Absolute paths (starting with /) are used as-is.
# -----------------------------------------------------------------------------
paths:
  # Where per-device baselines + IPS mitigation state are persisted between
  # restarts. [RESTART]
  state_path: state/ids_state.json

  # Where the trained per-device/global ML anomaly model is loaded from and
  # (on retrain) saved to. [RESTART]
  model_path: models/ids_model.pkl

  # MaxMind GeoLite2 City database (.mmdb) for country/city IP lookups — used
  # by GeoIP telemetry AND by geofencing below (geofencing can't fire at all
  # if this file fails to load — check your startup logs for "GeoIP features
  # will be disabled" if geofencing ever seems inactive). ASSUMPTION: this
  # path assumes you'll place/symlink your .mmdb files under <repo_root>/models/
  # — correct it if yours live somewhere else. [RESTART]
  geoip_db: models/GeoLite2-City.mmdb

  # Optional MaxMind GeoLite2 ASN database — enables ASN/org name in GeoIP
  # telemetry. Leave pointing at a missing file to keep ASN/org fields as
  # "unknown" (same as leaving this blank). [RESTART]
  geoip_asn_db: models/GeoLite2-ASN.mmdb

  # pihole_db and zeek_log_dir moved to the "external_system_paths" section at the
  # very bottom of this file (with reactive_capture_zeek_bin) -- they describe OTHER
  # software's installation layout on this machine, not this app's own data, and
  # getting them wrong is a genuinely different kind of mistake than relocating one
  # of THIS app's own relative files. See that section's warning banner.

  # Every evaluated alert is appended here (also the training data source for
  # the weekly false-positive classifier retrain). [RESTART]
  # PHASE 16 FIX: was a bare "alerts.json" with no state/ prefix -- since this is a
  # relative path, it resolved against whatever the process's CWD happened to be
  # (in practice, the project root), landing outside state/ entirely despite every
  # other state file and every doc assuming it lives in state/. retro_hunter.py,
  # ollama_soc.py, and train_fp_classifier.py all already default their OWN fallback
  # reads to "state/alerts.json" when this key is absent -- this now matches that
  # convention instead of silently overriding it with a root-level path.
  # If you're updating an existing deployment: move your current alerts.json into
  # state/ before restarting, or the training-data history will appear to reset.
  alert_json_path: state/alerts.json

  # Once alert_json_path exceeds this many bytes, older entries are pruned
  # (currently 1 GiB). [RESTART]
  alert_json_max_bytes: 1073741824

  # Path (relative to this file's own directory) to your .env secrets file.
  # ".env" is correct for the standard layout (.env sitting next to this
  # config.yaml at the repo root) — change only if you keep secrets somewhere
  # else. [RESTART]
  env_file: .env


# -----------------------------------------------------------------------------
# network_and_devices — your LAN topology and per-device classification
# -----------------------------------------------------------------------------
network_and_devices:
  # Your home LAN in CIDR form. Legacy single-subnet key — still used as the
  # fallback whenever home_subnets (below) is empty. [LIVE]
  home_subnet: 192.168.1.0/24

  # Preferred multi-subnet form: a list of CIDR ranges. Populate this once you
  # have more than one home subnet to track (e.g. a separate IoT VLAN); while
  # empty, home_subnet (above) is used instead. [LIVE]
  home_subnets: [192.168.1.0/24, 192.168.50.0/24]

  # Safety cap on how many distinct devices get their own tracked baseline
  # state at once (memory/disk bound). [RESTART]
  max_device_states: 5000

  # IPs that are NEVER treated as suspicious destinations even if flagged
  # elsewhere (your own infra: Pi-hole DNS server, router, this host, etc.).
  # Example below covers the common set — loopback, your router, the box
  # running this IDS, and a NAS; add as many entries as your own network needs.
  # [LIVE]
  safe_ips:
    - 127.0.0.1
    - 192.168.1.1    # router / gateway
    - 192.168.1.2    # this IDS host
    - 192.168.1.3    # NAS

  # Decoy IP(s) on your LAN. Any device that contacts one gets an instant
  # 10.0 (max) risk score — deploy an unused IP running a fake SSH/SMB
  # listener at each address for it to mean anything. One or many — a second
  # honeypot on a different VLAN/subnet is a common reason to add more. [LIVE]
  honeypot_ips:
    - 192.168.1.200
    - 192.168.50.200

  # Domains never treated as suspicious (like safe_ips, but for DNS queries).
  # Empty by default — populate with any domain you've confirmed benign and
  # never want re-flagged, e.g.:
  #   safe_domains:
  #     - mycompany-vpn.example.com
  #     - printer.local
  # [LIVE]
  safe_domains: []

  # eTLD+1 base domains treated as known-safe CDN/vendor/cloud infrastructure for the
  # DNS-tunneling (threat_signals.py) and DNS-evasion blind-spot (dns_evasion.py)
  # exemption checks specifically -- distinct from safe_domains above (which is a
  # broader "never suspicious anywhere" exact-match exclusion). Most legitimate vendor
  # domains are already caught automatically by ti_engine.is_allowlisted() (Tranco
  # popularity + the CL-AFPE self-healing trust cache) or by recognizing the
  # destination's hosting ASN as a known cloud/CDN operator (utils.py's
  # is_cloud_cdn_provider_org()) -- this list is only for the residual case: a
  # legitimate but low-traffic, single-vendor domain that's neither popular enough for
  # Tranco nor hosted on infrastructure an ASN-org match would catch. Add an entry here
  # (base domain only, e.g. "samsungcloudsolution.net" not
  # "lcprd1.samsungcloudsolution.net") and it applies on the next config reload -- no
  # code change/deploy needed. [LIVE]
  safe_cdn_base_domains:
    - samsungcloudsolution.net
    - myprinterbrand-cloud.com

  # Hostname substrings that mark a device as "safe infrastructure" (Pi-hole,
  # your repeater, etc.) — dampens noisy behavioral evidence for these
  # devices without excluding real threat signals (reputation/honeypot
  # evidence is never dampened). [LIVE]
  safe_host_patterns:
    - paperless
    - repeater
    - pi-hole
    - pihole
    - pi.hole
    - pi_hole

  # Manual device-type overrides by hostname or IP, where auto-classification
  # gets it wrong or you want to lock it down. Values: laptop, desktop,
  # phone, tablet, smart_tv, gaming_console, printer, nas, iot, camera,
  # server, unknown, dns_server, router, gateway. The last three additionally
  # grant "verified infra" status (device_type_is_override=True) -- see
  # pipeline.py's _INFRA_DEVICE_TYPES/_INFRA_NOISY_TYPES -- which dampens that
  # device's own DNS/connection-volume noise without touching reputation/
  # honeypot/lateral-movement evidence. Matching is by hostname SUBSTRING
  # (case-insensitive), first entry wins in file order -- pick a specific
  # pattern to avoid an unintended collision with an unrelated device sharing
  # part of the same name. [LIVE]
  device_type_overrides:
    LAPTOP-A1B2C3: laptop
    lghometheater: smart_tv
    DIR355BT: iot
    family-pc: laptop
    dreame: iot
    Chromecast: iot
    Watch: phone
    # More specific pattern listed BEFORE the generic "Samsung" one below --
    # first-match-wins, so this stops "Samsung" from incidentally also catching
    # this Samsung Smart Monitor (its hostname contains "samsung" too). Same
    # resulting classification either way (a Tizen smart monitor behaves like a
    # smart_tv in practice -- apps, Netflix, discovery protocols), just now an
    # intentional match instead of an accidental substring collision.
    samsungsmartmonitor: smart_tv
    Samsung: smart_tv
    linux-server: server
    Kindle: tablet
    "192.168.1.3": nas
    android_4: smart_tv
    # Your Pi-hole/unbound resolver host -- device_type_overrides is the ONLY way to
    # reach "verified infra" status (device_type_is_override=True), which is what
    # pipeline.py's _INFRA_NOISY_TYPES gate requires before dampening this device's
    # own DNS-evasion/connection-abuse noise; infer_device_type() alone can't get here
    # since "paperless" doesn't match any of its pihole/unbound/adguard hostname
    # keywords. [LIVE]
    paperless: dns_server


# -----------------------------------------------------------------------------
# detection_engine — core scoring loop timing and sensitivity
# -----------------------------------------------------------------------------
detection_engine:
  # Python logging level (DEBUG/INFO/WARNING/ERROR). [LIVE]
  log_level: INFO

  # How often (seconds) the main loop polls Pi-hole's DB for new queries.
  # 2s is optimal here — Pi-hole's DB is event-driven, not time-driven, so
  # lower doesn't meaningfully help. [LIVE]
  poll_interval: 2

  # Sliding window (seconds) used for rate/entropy/uniqueness baselines.
  # 300s (5 min) — faster DGA detection than the old 600s. [LIVE]
  window_seconds: 300

  # On startup, how far back (seconds) to backfill from existing logs before
  # going live. [LIVE]
  startup_lookback_seconds: 300

  # Risk score (0-10 scale) at which an evaluation becomes an alert.
  # 6.0 — well-calibrated after false-positive sensitivity fixes. [LIVE]
  alert_threshold: 6.0

  # Standard-deviation multiplier for statistical anomaly thresholds. [LIVE]
  threshold_std_dev: 3.0

  # How many samples a device's per-device ML model needs before it starts
  # actively scoring (vs. staying in warmup). 5000 → activates in ~2.8h
  # instead of the old 10000's ~5.5h. [LIVE]
  ml_warmup_samples: 5000

  # EWMA smoothing factor for rate/entropy/unique-domain baselines. 0.05 is
  # the correct speed for this signal — don't change without reason. [LIVE]
  baseline_alpha: 0.05

  # Decay factor for domain-count baselines — 0.995 gives a ~4.6 minute
  # half-life. [LIVE]
  decay_factor: 0.995

  # How long (seconds) a SUSPICIOUS state must persist uninterrupted with the
  # same signature before it's escalated to HIGH. [LIVE]
  suspicious_escalation_seconds: 600.0

  # VERSION 10 (incident aggregation, core/incident_tracker.py): how long a gap since
  # the last occurrence of a given device+target+signature combination before the NEXT
  # occurrence is treated as a genuinely new incident rather than a continuation of the
  # same one. [LIVE]
  incident_grouping_window_seconds: 1800.0

  # VERSION 10 (incident aggregation): minimum spacing between periodic "still ongoing,
  # N occurrences" Telegram re-notifications for one incident that's staying open --
  # this is the knob that controls Telegram volume for a long-running incident (a
  # severity escalation, e.g. SUSPICIOUS -> HIGH, always re-notifies immediately
  # regardless of this interval). alerts.json still gets a line every qualifying cycle
  # unconditionally -- this only affects the Telegram push. [LIVE]
  incident_update_min_interval_seconds: 900.0

  # Distinct IPs a device must ARP-request within one window_seconds window to
  # be flagged as a host-discovery sweep (arp_sweep evidence, threat_signals.py).
  # Broadcast-visible, so this reaches WiFi devices the same way MAC correlation
  # already does. Not a hard-stop on its own -- corroborates
  # ConnectionAbuseHypothesis, needs a second independent source to reach HIGH.
  # [LIVE]
  arp_sweep_unique_targets_threshold: 8

  # BUGFIX: found via a live third-party review of a real tarpit alert, verified
  # against production data -- zeek_lateral_moves was a raw COUNT of connections to
  # LATERAL_PORTS (22/445/3389/5900/23), with fp_engine.py's Stage-1 hard-stop and
  # pipeline.py's lateral_threat (which authorizes Layer-2 tarpit, bypassing the
  # normal risk>=9.0 floor) both gating on a bare `> 0` check -- confirmed live: a
  # single ordinary SMB connection (zeek_lateral_moves=1) was sufficient to reach
  # CONFIRMED_THREAT and trigger containment, no different treatment from a genuine
  # multi-target scan. Distinct DESTINATION IPs on lateral-movement-relevant ports
  # a device must touch within one window_seconds window before either of those two
  # consequential gates treats it as "lateral movement" rather than routine access
  # to a single internal service (a NAS, a home server via SSH/RDP). [LIVE]
  lateral_movement_unique_targets_threshold: 2

  # Destination ports treated as "lateral-movement-relevant" -- a real attacker isn't
  # limited to these, so this is here to be EXTENDED (add a custom app/service port
  # your network actually runs) rather than treated as exhaustive. [RESTART -- read
  # once at ZeekFeatureExtractor construction]
  lateral_movement_ports: [22, 445, 3389, 5900, 23]


# -----------------------------------------------------------------------------
# false_positive_engine — CL-AFPE (autonomous false-positive suppression)
# 3-stage pipeline: hard-stop security filter → LightGBM tabular classifier →
# FastEmbed semantic domain-similarity matcher. The four thresholds below
# directly retune Stage 2/3 sensitivity, live, no restart (verified: reading
# these is a fresh self.config.get() call on every alert evaluation).
# -----------------------------------------------------------------------------
false_positive_engine:
  # PHASE 21D3: how long a network-confirmed threat IOC (IP/domain) stays a hard-stop
  # for OTHER devices touching it (local_intel.py). Confirmed-malicious infrastructure
  # from months ago may be repurposed or abandoned, so this is deliberately
  # TTL-bounded, not permanent -- same reasoning as fp_trust_cache's 14-day TTL, just a
  # longer window since this is confirmed-threat evidence, not confirmed-safe.
  # [RESTART] (read once at AutonomousFPEngine construction)
  local_confirmed_intel_ttl_seconds: 2592000.0  # 30 days

  # Stage 2: minimum LightGBM P(false positive) to lean towards suppression.
  # Lower = engine trusts the tabular model more readily. [LIVE]
  fp_lgbm_threshold: 0.75

  # Stage 3: minimum cosine similarity to a known-safe vendor domain pattern
  # to count as a match. Lower = more domains get matched as "looks like a
  # known vendor". [LIVE]
  fp_embed_similarity_threshold: 0.82

  # Combined (Stage2×0.45 + Stage3×0.55) confidence required to AUTO-SUPPRESS
  # an alert as a false positive. Lower = fewer Telegram pings but higher risk
  # of quietly swallowing a real threat. Higher = noisier but safer. [LIVE]
  #
  # PHASE 12: this is the ONE value scripts/train_fp_classifier.py's weekly
  # self-calibration pass may autonomously lower, based on operator-confirmed
  # FP evidence (see calibrate_suppress_threshold() there for the exact rule).
  # It NEVER edits this number here — autonomous adjustments live entirely in
  # state/config_overrides.json, a separate file, so this baseline always
  # reflects what a human actually set. Delete that file (or the one key in
  # it) to instantly revert to the value below, no restart needed.
  fp_combined_suppress_threshold: 0.8

  # Combined confidence above which an alert that DIDN'T clear the suppress
  # threshold still gets tagged "⚠️ Low Confidence" instead of a normal alert.
  # [LIVE]
  fp_combined_uncertain_threshold: 0.55

  # Send a non-blocking "🔔 Auto-action" Telegram notification (with a
  # one-tap Revoke button) whenever the engine autonomously immunizes a NEW
  # domain. [LIVE]
  fp_revoke_notifications_enabled: true

  # How long (seconds) the one-tap Revoke option stays available after an
  # autonomous immunization. Default 86400 = 24h. [LIVE]
  fp_revoke_action_ttl_seconds: 86400.0

  # How long (seconds) an operator's "Mark False Positive" correction stays
  # active as training-correction signal for the weekly retrain. Default
  # 2592000 = 30 days. [LIVE]
  fp_operator_feedback_ttl_seconds: 2592000.0


# -----------------------------------------------------------------------------
# device_identity — MAC-rotation / re-identification resilience
# -----------------------------------------------------------------------------
device_identity:
  # Whether a device that rotates its MAC/IP can be automatically re-linked
  # to its prior identity (keeping threat history) instead of starting a
  # fresh cold-start profile. [LIVE]
  identity_reidentify_enabled: true

  # Minimum match-confidence score (0-1, from DHCP fingerprint + JA3/JA4
  # overlap) required to auto-merge two identities. [LIVE]
  identity_reidentify_min_confidence: 0.75

  # How long (seconds) a candidate stays eligible for re-identification
  # merging after last being seen. Default 1800 = 30 min. [LIVE]
  identity_reidentify_window_seconds: 1800.0

  # Your LAN's own gateway/router IP. A router genuinely has multiple distinct
  # physical MACs (LAN/WLAN/WAN interfaces), so MAC-based correlation above can
  # never fully unify it into one device_id on its own -- this pins it to one
  # fixed canonical device_id instead. Same value as fritzbox_router.fritz_ip
  # below on this deployment, but kept as its own key so device-identity
  # resolution doesn't implicitly depend on the Fritz!Box integration being
  # configured. Leave blank ("") to disable this special-case. [LIVE]
  gateway_ip: 192.168.1.1


# -----------------------------------------------------------------------------
# geofencing — block traffic to specific countries by GeoIP
# NOTE: this can only ever fire if paths.geoip_db above successfully loads —
# see the comment on that key. If geofencing seems to never trigger, check
# your startup logs for a GeoIP load failure first.
# -----------------------------------------------------------------------------
geofencing:
  # Master on/off switch. When true, any device that contacts an IP whose
  # GeoIP country is in geofencing_countries gets an instant CRITICAL/block
  # verdict (same severity as a confirmed malicious IOC). [LIVE]
  geofencing_enabled: true

  # ISO country codes to block. Currently a blocklist ONLY — there is no
  # allowlist mode and no time-of-day policy support in the code today,
  # despite those having been planned at some point (see
  # CONFIG_AUDIT_REPORT.md's dead-key section for the removed
  # geofencing_mode / geofencing_time_policies keys). [LIVE]
  geofencing_countries:
    - RU
    - KP
    - IR


# -----------------------------------------------------------------------------
# threat_intel_and_ai — external threat-intel refresh + local Ollama LLM
# -----------------------------------------------------------------------------
threat_intel_and_ai:
  # How often (seconds) OTX/AbuseIPDB/VirusTotal feeds refresh. Default 3600
  # = hourly. (API keys themselves come from .env, not this file.) [LIVE]
  ti_refresh_interval: 3600

  # Base URL of your local Ollama server, used by scripts/ollama_soc.py (batch triage,
  # every 4h) and intelligence/ai_soc.py's DeterministicValidator for LLM-based alert
  # triage and summaries. [LIVE]
  ollama_url: http://192.168.1.2:11434

  # Ollama model name to use for those requests. [LIVE]
  ollama_model: llama3.1

  # PHASE 11: how long a cached LLM verdict for a given "threat pattern" (device +
  # destination + signature) stays valid before scripts/ollama_soc.py will query Ollama
  # about it again. A live diagnostic run found single Ollama calls taking 14+ minutes
  # under real CPU load on this hardware -- caching avoids re-paying that cost for a
  # threat pattern that's still recurring. Default 604800 = 7 days. [LIVE]
  ollama_cache_ttl_seconds: 604800.0

  # PHASE 11: hard cap on FRESH Ollama calls per scheduled ollama_soc.py run (cache hits
  # don't count against this). Keeps one unusually noisy day from turning a 4-hourly job
  # into an hours-long one -- at up to ~15 minutes worst-case per call (the request
  # timeout), 8 calls is at most ~120 minutes, comfortably inside the 4h gap to the next
  # run. Alerts beyond this cap are deferred to the next scheduled run, prioritized by
  # which threat pattern repeated most often this run. [LIVE]
  # BUGFIX (2026-08-27): raised from 3 -- the scheduler.py cron entry for this job had
  # drifted to once/day (see scheduled_jobs.scheduler.ollama_soc below, now corrected
  # back to the 4-hourly cadence this comment and ollama_soc.py's own code already
  # assumed) while this cap stayed sized for a single daily run against a day's worth of
  # traffic. Live data: 839 alerts / 163 distinct patterns in one 24h window, only 3 of
  # which got a fresh LLM verdict -- the other 160 were deferred and re-evaluated against
  # a rolling 24h window every subsequent run, rather than ever actually draining.
  ollama_max_queries_per_run: 8


# -----------------------------------------------------------------------------
# ips_mitigation — active response master switches
# Per-mechanism toggles (Pi-hole sinkhole / router hardware isolation /
# ARP tarpit) are NOT here — they come from .env (see the "secrets" note
# below), since they're treated the same as other sensitive infrastructure
# controls. This section is the master switches + response POLICY only.
# -----------------------------------------------------------------------------
ips_mitigation:
  # Global kill switch for all active response (Pi-hole sinkhole, router
  # isolation, ARP tarpit). false = detection-only, nothing gets blocked.
  # [LIVE]
  ips_enabled: true

  # true = a human must tap "Approve" in Telegram before a hardware isolation
  # action executes. false = fully autonomous auto-block. [LIVE]
  interactive_blocking_enabled: true

  # Cooldown (seconds) after an operator manually releases a device before
  # it can be auto-isolated again. Default 3600 = 1h. [LIVE]
  operator_release_cooldown_seconds: 3600.0

  # true = IPS actions are logged as if they executed but nothing actually
  # happens on the network (dry-run / testing mode). [LIVE]
  simulation_mode: false


# -----------------------------------------------------------------------------
# pihole_integration — Pi-hole API behavior (URL/password come from .env)
# -----------------------------------------------------------------------------
pihole_integration:
  # Pi-hole v6 API base path for domain sinkholing calls -- the code appends
  # /deny/exact[/{domain}] itself (v6's actual REST shape; confirmed live against a
  # running Pi-hole v6 instance -- the old /api/v2/domains 404'd on every single call,
  # meaning every real block/unblock had been silently falling through to the CLI
  # fallback this whole time). [LIVE]
  pihole_api_path: /api/domains

  # HTTP timeout (seconds) for Pi-hole API calls. [LIVE]
  pihole_api_timeout_seconds: 5.0

  # Pi-hole v6 REST API path for domain SEARCH (gravity/blocklist match lookup) --
  # deliberately a different endpoint from pihole_api_path above (that one manages
  # this IDS's own block/unblock entries; this one queries Pi-hole's already-
  # maintained ad/tracker gravity classification). Used by
  # ThreatIntel.is_pihole_gravity_domain() to dampen DNS-tunneling/telemetry checks
  # for domains your own Pi-hole already recognizes as routine ad/telemetry traffic,
  # reusing the same pihole_api_url/pihole_api_password auth as the block/unblock
  # calls above. NEEDS LIVE VALIDATION against your Pi-hole version -- written against
  # v6's documented REST API shape, fails safely to "unknown" (never a false
  # negative) if your instance's response shape differs. [LIVE]
  pihole_search_api_path: /api/search


# -----------------------------------------------------------------------------
# fritzbox_router — Fritz!Box hardware isolation integration
# (user/password/API token come from .env)
# -----------------------------------------------------------------------------
fritzbox_router:
  # Your Fritz!Box's LAN IP — the target for TR-064 isolation calls. [LIVE]
  fritz_ip: 192.168.1.1

  # HTTP timeout (seconds) for the isolate-device webhook call. [LIVE]
  router_webhook_timeout_seconds: 5.0

  # URL this process's own FastAPI server polls to keep the router's
  # connected-hosts list in sync (used by core/identity.py). [LIVE]
  router_hosts_url: http://127.0.0.1:8010/hosts

  # HTTP timeout (seconds) for that hosts-list poll. [LIVE]
  router_hosts_timeout_seconds: 5.0

  # How often (seconds) ips.py's reconcile worker asks Fritz!Box for each
  # router-isolated device's REAL current WAN-access state, and clears this IDS's
  # own record for any device Fritz!Box no longer actually has blocked (e.g. an
  # operator released it directly in the Fritz!Box admin UI, bypassing this IDS
  # entirely) -- without this, that device shows "still isolated" in Grafana
  # forever, since nothing else ever tells this IDS to forget it. [LIVE]
  router_reconcile_interval_seconds: 300.0


# -----------------------------------------------------------------------------
# reactive_capture — Fritzbox diagnostic-capture burst client (Phase C).
# Auth is the router's login_sid.lua challenge-response flow -- a separate mechanism
# from the TR-064 auth fritzbox_router above uses, confirmed via live testing this
# session; reuses the same fritz_ip/fritz_user/fritz_password. See
# src/extractors/fritzbox_capture.py's module docstring for the confirmed capture
# mechanism (the Start request's response body IS the live pcap stream).
# NOT wired to any automatic trigger yet (that's Phase D) -- this only controls the
# capture+ingest mechanism itself, callable directly today for a manual/operator burst.
# -----------------------------------------------------------------------------
reactive_capture:
  # Master switch. False by default -- flip to true once you're ready for the live
  # deployment to actually fire capture bursts (Phase D's triggers below are wired and
  # live-verified as of this session, see zeek_scripts/local-arp-log.zeek's deployment
  # notes and this phase's commit message). [LIVE]
  reactive_capture_enabled: true

  # The ONE shared aggressiveness knob (Phase D design): every trigger below draws
  # from this single hourly budget instead of a per-trigger-type cooldown, since a
  # single burst captures the WHOLE radio regardless of which source fired it --
  # trigger-source count doesn't multiply capture cost, only actual burst-execution
  # count does. Default ~1 every 10 minutes at full utilization. [LIVE]
  reactive_capture_max_bursts_per_hour: 6

  # Per-trigger enable flags -- each source can be individually disabled without
  # touching the shared budget above. All default on, per explicit operator direction
  # ("more trigger rather than conservative"). [LIVE]
  reactive_capture_new_device_trigger_enabled: true
  reactive_capture_arp_sweep_trigger_enabled: true
  reactive_capture_dns_trigger_enabled: true
  reactive_capture_high_severity_trigger_enabled: true

  # Fires when state_guard.py's MAC-rotation re-identification finds a candidate
  # strong enough to log about (>= MIN_CANDIDATE_CONFIDENCE) but not strong enough to
  # auto-merge (< the merge bar used) -- genuinely ambiguous. Fresh JA4/DHCP data from
  # the burst can resolve it on a later cold-start of the same physical device instead
  # of it staying stuck below the merge bar indefinitely. [LIVE]
  reactive_capture_reid_ambiguous_trigger_enabled: true

  # Fires when a new, previously-unseen source IP contacts one of the devices listed
  # in reactive_capture_wired_probe_ips below -- these are devices with full Zeek flow
  # visibility already (unlike WiFi devices), so this uses data that's already
  # flowing, no new detector needed. [LIVE]
  reactive_capture_wired_probe_trigger_enabled: true

  # The wired device IP(s) reactive_capture_wired_probe_trigger_enabled watches for a
  # new source -- your NAS and the Ubuntu server itself. [LIVE]
  reactive_capture_wired_probe_ips:
    - 192.168.1.3   # NAS
    - 192.168.1.2   # this IDS host

  # Periodic baseline spot-check, in-process (not a separate scheduled script -- see
  # pipeline.py's PHASE 21D comment on why: a burst's findings only reach live
  # detection by ingesting into the SAME long-running ZeekFeatureExtractor instance
  # the pipeline already holds, which a separate subprocess couldn't share). [LIVE]
  reactive_capture_spotcheck_enabled: true
  reactive_capture_spotcheck_interval_seconds: 1800.0

  # Which Fritzbox diagnostic interfaces to capture per burst. ath0/ath1 are this
  # router's 2.4GHz/5GHz radios -- confirmed via live testing to be the only
  # interfaces that see WiFi-to-WiFi traffic (see PRODUCT_ARCHITECTURE.md). A burst
  # captures all configured radios simultaneously in one shared window. [LIVE]
  reactive_capture_radios:
    - ath0
    - ath1

  # How long one capture burst runs, in seconds. ~3GB/hour combined dual-radio cost
  # measured live this session -> a 120s burst is roughly 100MB. [LIVE]
  reactive_capture_burst_seconds: 120.0

  # Per-packet snapshot length (bytes) requested from the router -- matches the
  # default the browser UI itself uses. [LIVE]
  reactive_capture_snaplen: 1600

  # Where raw/converted pcaps and Zeek's scratch reprocessing output are written.
  # [LIVE]
  reactive_capture_scratch_dir: state/reactive_capture

  # Disk safety: delete each burst's raw/converted pcaps and Zeek scratch logs right
  # after ingestion (~100MB+ per burst; continuous dual-radio capture measured at
  # ~3GB/hour live this session -- unbounded retention fills a disk over weeks). A
  # compact permanent JSONL summary (reactive_capture_history.jsonl, in the scratch
  # dir above) is kept regardless of this setting. Set false only if you specifically
  # want raw pcaps retained for manual forensic analysis -- you'll need to manage
  # their disk usage yourself. [LIVE]
  reactive_capture_delete_after_ingest: true

  # VERSION 11 (P2, Suricata follow-up): batch-mode signature/exploit scan of the
  # SAME burst pcap Zeek already reprocesses -- runs `suricata -r burst.pcap` once
  # per burst (never continuously against live traffic, so idle cost is zero and
  # this stays workable on a Raspberry Pi target), turning real rule matches into
  # Evidence (see intelligence/detectors/suricata_scan.py). Defaults to false: this
  # does nothing until you (1) install Suricata, (2) point
  # reactive_capture_suricata_bin/_rules_path (below, in external_system_paths) at
  # a real binary and a ruleset you manage yourself (e.g. `suricata-update --etopen`
  # with a trimmed "security"/"balanced" policy, not the full noisy feed), and
  # (3) set this to true. [LIVE]
  reactive_capture_suricata_enabled: true

  # Max seconds to let one batch scan run before giving up on it (non-fatal --
  # the burst's Zeek/DNS-evasion findings are unaffected either way). A burst pcap
  # is bounded (reactive_capture_burst_seconds above), so this should rarely if
  # ever be reached. [LIVE]
  reactive_capture_suricata_timeout_seconds: 240.0

  # reactive_capture_zeek_bin moved to the "external_system_paths" section at the
  # very bottom of this file, alongside pihole_db/zeek_log_dir -- same reasoning
  # (describes YOUR Zeek installation's layout, not this app's own data).


# -----------------------------------------------------------------------------
# telegram — bot notification behavior (token/chat ID come from .env)
# -----------------------------------------------------------------------------
telegram:
  # Master switch for Telegram alerting. [LIVE]
  telegram_enabled: true

  # Allowlist of chat IDs permitted to send bot COMMANDS (approve/release/
  # revoke buttons). Empty = allow commands from any chat that has the bot
  # (backward-compatible default) — populate this if you ever add the bot to
  # a shared/group chat and want to restrict who can act on alerts, e.g.:
  #   telegram_allowed_chat_ids: [123456789, -100987654321]
  # (a positive ID is a private/DM chat, a negative one a group — both forms
  # are valid entries in this list). [LIVE]
  telegram_allowed_chat_ids: []


# -----------------------------------------------------------------------------
# scheduled_jobs — background jobs, polled every 60s by scripts/scheduler.py
# Cron fields are minute/hour/day/month/day-of-week. Only "*", "*/N", and an
# exact integer are supported per field (no comma-lists, no ranges).
# Verified: no two jobs below fire in the same hour as each other.
# -----------------------------------------------------------------------------
scheduled_jobs:
  # Weekly/nightly retrain of the false-positive LightGBM classifier
  # (scripts/train_fp_classifier.py) — this one is NOT in the `scheduler`
  # dict below, it has its own dedicated enable/cron pair. Fires at 3am.
  # [LIVE]
  autotune_enabled: true
  autotune_schedule_cron: "0 3 * * *"

  # Everything else scheduler.py launches. Each job: enabled (bool), cron
  # (string), and an optional "script" override if the job's key doesn't
  # match its own filename (needed for retro_hunter — see
  # CONFIG_AUDIT_REPORT.md's Phase 7 note on why that override exists).
  scheduler:
    # LLM-based alert triage summaries, every 4 hours starting at midnight.
    # BUGFIX (2026-08-27): this had drifted to "30 4 * * *" -- once/day at 4:30am --
    # despite the comment (and ollama_soc.py's own DEFAULT_MAX_QUERIES_PER_RUN comment,
    # config.yaml's ollama_max_queries_per_run comment, and the "well inside the 4h gap
    # between scheduled runs" reasoning throughout that file) all assuming a 4-hourly
    # cadence. Corrected to match the documented intent instead of editing the comment
    # to match the wrong behavior.
    ollama_soc:
      enabled: true
      cron: "30 */4 * * *"

    # Retroactive threat-intel re-scan of recent history. 2am.
    retro_hunter:
      enabled: true
      cron: "0 2 * * *"
      script: retro_hunter.py

    # Daily "top domains per device" Markdown + Telegram summary report. 6am.
    top_domains_report:
      enabled: true
      cron: "0 6 * * *"

    # Shadow-mode divergence watcher (Documentation/DECISION_LOGIC_DEPENDENCY_MAP.md) --
    # fires a Telegram alert the moment state/shadow_decisions.jsonl gets a new entry.
    # Temporary: remove this job once the evidence-taxonomy fix is either flipped live or
    # abandoned -- it has nothing to watch once shadow_decisions.jsonl stops being written.
    shadow_watcher:
      enabled: true
      cron: "*/5 * * * *"


# =============================================================================
# Secrets — NOT in this file
# =============================================================================
# These come from .env (path set by paths.env_file above) as environment
# variables, applied on every reload via config.py's apply_env_overrides():
#
#   TELEGRAM_TOKEN, TELEGRAM_CHAT_ID           → Telegram bot credentials
#   OTX_API_KEY                                → AlienVault OTX
#   ABUSEIPDB_KEY (or ABUSEIPDB_API_KEY)       → AbuseIPDB
#   VIRUSTOTAL_KEY (or VIRUSTOTAL_API_KEY)     → VirusTotal
#   PIHOLE_API_PASSWORD, PIHOLE_API_URL        → Pi-hole admin API
#   FRITZ_USER, FRITZ_PASS                     → Fritz!Box TR-064 login
#   API_SECRET_TOKEN                           → this app's own webhook auth token
#   ROUTER_WEBHOOK_URL                         → isolate-device webhook URL
#   IDS_IPS_PIHOLE_ENABLED                     → per-mechanism IPS toggle: DNS sinkhole
#   IDS_IPS_ROUTER_ENABLED                     → per-mechanism IPS toggle: hardware isolation
#   IDS_IPS_TARPIT_ENABLED                     → per-mechanism IPS toggle: ARP tarpit
#
# PHASE 13 cleanup: OLLAMA_API_KEY / ollama_api_key removed — it existed only for the
# real-time intelligence/ollama_analyzer.py path, which was itself dead (instantiated but
# its one method was never called). scripts/ollama_soc.py is the only remaining Ollama
# consumer and doesn't send any auth header. If your Ollama server ever needs auth, say so
# and this can be added back on the path that's actually live.
#
# Setting any of these in THIS file too would work (it'd just get silently
# overwritten by .env on the next reload) but would be misleading, so don't.
#
# Two .env variables are NOT read by this app at all — ZEEK_INTERFACE and
# HOME_SUBNET are consumed by your Zeek deployment scripting only. In
# particular, .env's HOME_SUBNET does NOT override this file's
# network_and_devices.home_subnet, despite the similar name — to change your
# tracked LAN subnet, edit THIS file, not .env.


# =============================================================================
# ⚠️  external_system_paths — DO NOT TOUCH unless you know what you are doing  ⚠️
# =============================================================================
# Every key above this banner is either an ordinary detection-tuning knob, or one
# of THIS app's own relative data files (state/, models/, .env) — safe to relocate
# freely, no outside knowledge required.
#
# The three keys below are DIFFERENT: they point at OTHER software's installation
# layout on THIS specific machine (your Pi-hole install, your Zeek install) — not
# anything Home-IDS controls or creates. They were deliberately pulled out of the
# normal "paths" section above and placed down here, alone, so they can't be
# casually edited alongside an ordinary tuning change.
#
# Get one of these wrong and the failure mode is NOT an error message pointing at
# this file — it's DNS telemetry silently going empty (pihole_db), Zeek features
# silently staying at zero for every device (zeek_log_dir), or every reactive-
# capture burst silently failing (reactive_capture_zeek_bin). Confirm the REAL path
# on your own system first (see each key's own comment for the exact command),
# then change it here — don't guess.
# =============================================================================
external_system_paths:
  # Pi-hole's own SQLite FTL database, read directly for DNS query telemetry.
  # This is Pi-hole's system path, not something Home-IDS creates or owns.
  # Standard for any Pi-hole install; leave as-is unless yours is nonstandard.
  # Verify: `ls -la /etc/pihole/pihole-FTL.db` on the box actually running Pi-hole.
  # [RESTART]
  pihole_db: /etc/pihole/pihole-FTL.db

  # Directory Zeek writes its live logs (conn.log, dns.log, etc.) into. Zeek's own
  # system path, driven by YOUR zeekctl/node.cfg LogDir setting, not this file.
  # Verify: `grep -i '^LogDir' /opt/zeek/etc/zeekctl.cfg` (see INSTALL.md §3
  # for the full zeekctl-managed-install path-discovery walkthrough — the
  # security:zeek OBS package does NOT use /etc/zeek/, a common wrong assumption
  # from other Zeek packaging). [RESTART]
  zeek_log_dir: /opt/zeek/logs/current

  # Path to the zeek BINARY (not the log dir above) used to reprocess a reactive-
  # capture burst offline (`<this> -r burst.pcap local`) -- must be the SAME
  # install/local.zeek policy the live deployment runs (JSON logging, mac-logging,
  # ja3/ja4), or a burst won't get the same signals live traffic does.
  # Verify: `which zeek` or `zeek-config --bin_dir` on the box running the capture
  # client. Default matches this repo's own INSTALL.md for a security:zeek/zeekctl
  # install. [LIVE]
  reactive_capture_zeek_bin: /opt/zeek/bin/zeek

  # Path to the suricata BINARY, used the same way as reactive_capture_zeek_bin
  # above -- offline batch mode only (`<this> -r burst.pcap -l scratch/ -S rules`),
  # never a continuously-running process. Only read when
  # reactive_capture_suricata_enabled is true. Verify: `which suricata`. Standard
  # Debian/Ubuntu package path (including under WSL2) -- `apt install suricata`.
  # On Raspberry Pi OS (Debian-based), the same package/path applies. [LIVE]
  reactive_capture_suricata_bin: /usr/bin/suricata

  # Path to a Suricata rules FILE (not a directory) this scan will load. NOT
  # shipped or authored by this project -- re-curating threat intelligence
  # Suricata/Emerging Threats already maintains would be low-value reinvention.
  # Standard way to manage this: install `suricata-update`, run it with a trimmed
  # policy (e.g. `suricata-update --etopen` then a "security"/"balanced" policy
  # filter, not the full ~40k-rule feed -- keeps both scan time and false-positive
  # volume down), and point this at the resulting rules file (commonly
  # /var/lib/suricata/rules/suricata.rules after suricata-update). Empty/missing
  # means the scan silently produces no findings -- not an error, see
  # suricata_scan.py's run_suricata_on_pcap(). [LIVE]
  reactive_capture_suricata_rules_path: /var/lib/suricata/rules/suricata.rules
