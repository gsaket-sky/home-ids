      "panel-3003": {
        "kind": "Panel",
        "spec": {
          "id": 3003,
          "title": "🧬 DGA Signature Combo: Entropy + C2 Beaconing",
          "description": "Two independent DGA/botnet signals plotted together so you can see them correlate: Shannon entropy of queried domain names (home_ids_entropy_avg — per ENGINEERING_MANUAL.md, values above ~4.5 mathematically indicate algorithmically-generated, non-human-typed domain names) and C2 beaconing count (home_ids_beaconing_c2_count — periodic, uniform outbound connections). When BOTH lines spike together, that's a strong Domain Generation Algorithm / botnet C2 pattern, much stronger evidence than either signal alone — this is exactly the combination the Hypothesis & Evidence Engine's DGA_BEACONING hypothesis looks for.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${PROMETHEUS_DS}"
                      },
                      "spec": {
