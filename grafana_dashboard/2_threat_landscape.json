        "spec": {
          "id": 10,
          "title": "Malicious JA4 Hits",
          "description": "Number of network connections whose TLS Client Hello fingerprint (JA4+) matched a known-malicious signature database (e.g. known RAT/C2 frameworks like AsyncRAT or Cobalt Strike). Any non-zero value here is high-confidence — JA4+ collisions with legitimate software are rare, so treat spikes as urgent.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
