    {
      "id": 13,
      "type": "text",
      "title": "\ud83d\udee1\ufe0f Active Mitigations State",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "transparent": false,
      "options": {
        "mode": "markdown",
        "code": {
          "language": "plaintext",
          "showLineNumbers": false,
          "showMiniMap": false
        },
        "content": "**Real-Time Intervention Audit**\nThese tables show the live, exact state of the Intrusion Prevention System (IPS). When the AI detects a verified threat, it triggers mitigations here.\n\n* **\u2705 Successfully Blocked**: Domains currently sinkholed for a specific device.\n* **\u274c Failed Blocks**: Domains the system tried to block, but the Pi-hole API failed or rejected.\n* **\ud83d\udd12 Isolated Devices**: Devices currently completely cut off from the network via Router Kill-Switch or Layer-2 Tarpit."
      }
    },
    {
      "id": 14,
      "type": "table",
      "title": "\u2705 Successfully Blocked Domains (Active)",
      "description": "List of malicious domains actively sinkholed by the Pi-Hole for the offending device.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 30
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${PROMETHEUS_DS}"
      },
      "targets": [
        {
          "expr": "home_ids_ips_active_blocks > 0",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
