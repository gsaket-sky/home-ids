      "panel-11": {
        "kind": "Panel",
        "spec": {
          "id": 11,
          "title": "📜 Global Threat Events (Live Stream)",
          "description": "Live feed of confirmed-threat and false-positive verdicts across your whole network (not filtered to one device). Use this to spot patterns across multiple devices at once — e.g. several devices suddenly hitting the same malicious domain usually means a compromised router, a malicious ad network, or a supply-chain issue in a shared app, not several independent infections.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${LOKI_DS}"
                      },
                      "spec": {
                        "expr": "{job=\"home_ids_alerts\"} | json | verdict=~\"CONFIRMED_THREAT|FALSE_POSITIVE\"",
                        "format": "table",
                        "instant": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
