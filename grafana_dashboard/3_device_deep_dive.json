  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "\ud83d\udd0d Device Investigation Profile",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "transparent": false,
      "options": {
        "mode": "markdown",
        "code": {
          "language": "plaintext",
          "showLineNumbers": false,
          "showMiniMap": false
        },
        "content": "**Select a single device from the dropdown above to investigate it.**\n\nThis page shows you exactly *why* the AI flagged the device. \n* **Threat Confidence**: 100% means the device is confirmed malicious.\n* **Anomaly Confidence**: 100% means the device is acting weird, but might just be a software update.\n* **FP Score**: If high, the AI thinks this alert is actually a False Positive and will suppress it."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Threat Confidence",
      "description": "Probability the device is compromised based on known threat heuristics.",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 0,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${PROMETHEUS_DS}"
      },
      "targets": [
        {
          "expr": "home_ids_threat_confidence{hostname=~\"$device\"}",
          "format": "time_series",
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 0.8
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
