# =============================================================================
# Home-IDS secrets — .env
# =============================================================================
# Copy this file to .env (same directory as config.yaml) and fill in real
# values. .env is gitignored — never commit the real file, only this example.
#
# Every key here is applied as an environment-variable override on every
# config reload (config.py's apply_env_overrides()) — see config.yaml's own
# "Secrets — NOT in this file" section for exactly which config key each one
# feeds. Leaving an integration's key(s) blank/unset disables that
# integration gracefully (e.g. no OTX_API_KEY just means AlienVault OTX
# lookups are skipped) rather than crashing on startup.
# =============================================================================


# -----------------------------------------------------------------------------
# Telegram — alerting + interactive approve/release/revoke buttons
# Get TELEGRAM_TOKEN from @BotFather; get your chat ID by messaging your new
# bot once, then GET https://api.telegram.org/bot<token>/getUpdates.
# -----------------------------------------------------------------------------
TELEGRAM_TOKEN=123456789:AAExampleBotTokenReplaceWithYourOwnFromBotFather
TELEGRAM_CHAT_ID=123456789


# -----------------------------------------------------------------------------
# Threat-intel feeds — all three are free-tier, optional, independent of
# each other (missing any one just disables that one signal source).
# -----------------------------------------------------------------------------
# AlienVault OTX — https://otx.alienvault.com/api
OTX_API_KEY=your_otx_api_key_here

# AbuseIPDB — https://www.abuseipdb.com/account/api (also accepted:
# ABUSEIPDB_API_KEY, same effect, use whichever name you prefer)
ABUSEIPDB_KEY=your_abuseipdb_api_key_here

# VirusTotal — https://www.virustotal.com/gui/my-apikey (also accepted:
# VIRUSTOTAL_API_KEY)
VIRUSTOTAL_KEY=your_virustotal_api_key_here


# -----------------------------------------------------------------------------
# Pi-hole — DNS query telemetry + domain sinkhole/unblock API calls
# PIHOLE_API_URL is your Pi-hole's admin base URL (v6 API); PIHOLE_API_PASSWORD
# is the same password you use to log into the Pi-hole web admin.
# -----------------------------------------------------------------------------
PIHOLE_API_URL=http://192.168.1.2/admin
PIHOLE_API_PASSWORD=your_pihole_admin_password_here


# -----------------------------------------------------------------------------
# Fritz!Box — TR-064 router hardware isolation + diagnostic-capture bursts
# Use a dedicated Fritz!Box user with the minimum required permissions, not
# your main admin login, if your Fritz!Box OS version supports multiple users.
# -----------------------------------------------------------------------------
FRITZ_USER=home-ids
FRITZ_PASS=your_fritzbox_user_password_here


# -----------------------------------------------------------------------------
# This app's own local webhook auth
# API_SECRET_TOKEN authenticates calls to this process's own FastAPI server
# (Telegram bot webhooks, Fritz!Box isolate/hosts endpoints) — generate a
# random value, e.g. `openssl rand -hex 32`, don't reuse a password.
# ROUTER_WEBHOOK_URL is the isolate-device webhook this process calls into
# itself (normally localhost, matching service_ports.fastapi_port in
# config.yaml).
# -----------------------------------------------------------------------------
API_SECRET_TOKEN=replace_with_a_long_random_hex_string
ROUTER_WEBHOOK_URL=http://127.0.0.1:8010/isolate


# -----------------------------------------------------------------------------
# Per-mechanism IPS toggles — each is independent of the master
# ips_mitigation.ips_enabled switch in config.yaml (that one gates ALL active
# response; these three gate one mechanism each). true/false.
# -----------------------------------------------------------------------------
IDS_IPS_PIHOLE_ENABLED=true
IDS_IPS_ROUTER_ENABLED=true
IDS_IPS_TARPIT_ENABLED=true


# -----------------------------------------------------------------------------
# Optional, NOT read by this app directly — only relevant if your own Zeek
# deployment scripting (not this repo's Python code) consumes them. See
# Documentation/INSTALL.md for your specific Zeek setup. Uncomment/set only if
# your own zeekctl/systemd unit expects them.
# -----------------------------------------------------------------------------
# ZEEK_INTERFACE=wlan0
# HOME_SUBNET=192.168.1.0/24
