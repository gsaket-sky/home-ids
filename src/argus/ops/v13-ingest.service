[Unit]
Description=v13 EvidenceGraph live ingestion daemon (Zeek log tailing + detection)
After=network.target
# .19's own Docker-hosted Ollama container is NOT a systemd unit on this host
# (it's inside Docker's own cgroup, managed by dockerd), so there is no direct
# systemd ordering dependency to declare here -- the isolation this unit
# provides is MemoryMax/CPUQuota below, not startup ordering.

[Service]
# Placeholder values below (User=user, /home/user/...) match Documentation/
# INSTALL.md 7.2's own soc.service example -- substitute your real deploy
# user/path, same as that file already tells you to for soc.service. Never
# commit the substituted real values back into this tracked file.
Type=simple
User=user
WorkingDirectory=/home/user/home_ids
ExecStart=/usr/bin/python3 /home/user/home_ids/src/argus/ingest/daemon.py /home/user/home_ids/config_v13.yaml
Restart=always
RestartSec=5

# Sized against .19's real confirmed spec (31GB RAM, 4C/8T i7-4810MQ --
# Documentation/V13_ARCHITECTURE_DEPENDENCY_MAP.md's hardware topology table,
# 2026-09-05) and this session's own live Docker headroom check (ollama+
# open-webui idle at ~780MB combined, 30GB+ free) -- generous relative to
# .94's own soc.service unit (MemoryMax=1G/CPUQuota=40%, Documentation/
# INSTALL.md 7.2) since this daemon does far less work (Zeek tailing +
# threat_signals.py's pure-function detection, no ML/LLM/GeoIP/mitigation
# subsystems) and .19 has roughly 3x the RAM/cores .94 does. The real intent
# is a CEILING, not a target -- this bounds worst-case runaway behavior (e.g.
# a log-parsing bug spinning in a tight loop) so it can never compete with
# a concurrent Ollama inference burst for the box's own cores/memory, not a
# tuned-for-throughput allocation. Revisit once real measured load exists
# (matches this project's own "measure, then decide" discipline -- e.g. the
# Phase 0 hardware-spec confirmation work).
MemoryMax=2G
CPUQuota=100%

[Install]
WantedBy=multi-user.target
